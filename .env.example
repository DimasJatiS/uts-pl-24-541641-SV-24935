# ─────────────────────────────────────────────────────────────────────────────
# Konfigurasi Docker Compose. Salin menjadi .env lalu isi nilai yang kosong:
#     cp .env.example .env
# File .env berisi rahasia → sudah ada di .gitignore, JANGAN di-commit.
# ─────────────────────────────────────────────────────────────────────────────

# Port di laptop untuk membuka aplikasi: http://localhost:8080
FRONTEND_PORT=8080

APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080

# WAJIB. Buat dengan salah satu perintah:
#   php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
#   echo "base64:$(openssl rand -base64 32)"
APP_KEY=

# Database MySQL (dibuat otomatis oleh container db saat pertama kali jalan).
DB_DATABASE=chainfolio
DB_USERNAME=chainfolio
# WAJIB. Isi password yang kuat (bebas, tidak perlu dihafal).
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Opsional: demo API key gratis dari CoinGecko. Kosong pun tetap jalan (rate limit lebih ketat).
COINGECKO_API_KEY=

# Masa berlaku token login (menit).
SANCTUM_EXPIRATION=1440
LOG_LEVEL=info

# Opsional: jalankan image hasil CI dari GitHub Container Registry, bukan build lokal.
# BACKEND_IMAGE=ghcr.io/<owner>/<repo>-backend:main
# FRONTEND_IMAGE=ghcr.io/<owner>/<repo>-frontend:main
