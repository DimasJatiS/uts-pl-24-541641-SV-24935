# Normalisasi line ending. Penting untuk pengguna Windows:
# script shell dan file konfigurasi container WAJIB LF, kalau CRLF container gagal start.
* text=auto eol=lf

*.sh text eol=lf
Dockerfile text eol=lf
Caddyfile text eol=lf
*.conf text eol=lf
*.yml text eol=lf

*.png binary
*.jpg binary
*.ico binary
