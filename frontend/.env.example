# ─────────────────────────────────────────────────────────────────────────────
# Variabel berawalan VITE_ ditanam ke file JavaScript saat `npm run build`,
# sehingga BISA DIBACA SIAPA PUN yang membuka aplikasi.
# → Hanya isi dengan nilai publik (URL API, nama aplikasi).
# → JANGAN taruh API key, password, atau token di sini.
# ─────────────────────────────────────────────────────────────────────────────

# URL dasar API. "/api" = origin yang sama (nginx/Vite proxy meneruskan ke Laravel).
VITE_API_BASE_URL=/api

# Hanya untuk `npm run dev`: alamat Laravel lokal. Tidak ikut ter-bundle
# karena tidak berawalan VITE_.
DEV_API_PROXY_TARGET=http://localhost:8000
