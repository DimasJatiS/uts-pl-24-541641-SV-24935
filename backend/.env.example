# ─────────────────────────────────────────────────────────────────────────────
# Konfigurasi untuk menjalankan backend LANGSUNG di laptop (php artisan serve).
# Untuk Docker Compose, yang dipakai adalah file .env di ROOT repository.
# Salin: cp .env.example .env  →  php artisan key:generate
# Jangan pernah commit file .env (sudah ada di .gitignore).
# ─────────────────────────────────────────────────────────────────────────────
APP_NAME=ChainFolio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL lokal (XAMPP/Laragon/MySQL server). Buat database "chainfolio" dulu.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chainfolio
DB_USERNAME=root
DB_PASSWORD=

# API murni berbasis token, jadi session cukup di memori.
SESSION_DRIVER=array
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log

# Token Sanctum kedaluwarsa setelah N menit (1440 = 1 hari).
SANCTUM_EXPIRATION=1440

# Origin yang boleh memanggil API langsung dari browser (dev server Vite).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Harga kripto. API key opsional (demo key gratis dari CoinGecko).
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=
COINGECKO_TIMEOUT=5
COINGECKO_CACHE_TTL=60
