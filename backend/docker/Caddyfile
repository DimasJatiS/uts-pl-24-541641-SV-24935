# Konfigurasi FrankenPHP (berbasis Caddy) untuk container backend.
# HTTPS tidak diaktifkan di sini karena container hanya diakses nginx
# di jaringan internal Docker; di production, TLS diterminasi di depan.
{
	skip_install_trust
	auto_https off
	admin off

	metrics

	servers :8000 {
		name app
	}
	servers :9180 {
		name metrics
	}

	frankenphp
	order php_server before file_server
}

:8000 {
	root * /app/public

	log {
		output stderr
		format console
	}

	encode zstd br gzip

	header {
		-Server
		-X-Powered-By
	}

	php_server
}

# metrik untuk prometheus (internal saja)
:9180 {
	metrics /metrics
}
